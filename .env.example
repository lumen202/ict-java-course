# Copy to .env.local and fill in. Never commit .env.local.
#
# None of these use the NEXT_PUBLIC_ prefix, and that's deliberate: Supabase is
# only ever touched from API routes on the server, so no key reaches the
# browser. Adding NEXT_PUBLIC_ to any of these would leak it into the client
# bundle — don't.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=

# Same page → Project API keys → "anon public".
# Students submit reflections with this key; RLS limits it to INSERT.
SUPABASE_ANON_KEY=

# Same page → Project API keys → "service_role". SECRET — bypasses RLS.
# Used only by /api/teacher/reflections to read submitted reflections.
SUPABASE_SERVICE_ROLE_KEY=

# Invent one. This is the whole teacher login for v1.
TEACHER_PASSCODE=
