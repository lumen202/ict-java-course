# Copy to .env.local and fill in. Never commit .env.local.
#
# Both variables ARE prefixed with NEXT_PUBLIC_ — that's required, not an
# oversight: Supabase Auth runs in the browser, so the URL and anon key must
# reach the client. This is safe. The anon key grants no data access by itself;
# Row Level Security (supabase/schema.sql) decides what each logged-in user may
# read or write — students only their own rows, teachers everyone's.
#
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Same page → API Keys → "anon public" (newer projects: "Publishable key")
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# OPTIONAL, server-only (no NEXT_PUBLIC_ prefix — it bypasses RLS).
# Used for invite emails, registration's create-account path, roster name fixes,
# and creating/deleting the throwaway accounts behind "Explore the demo". Leave
# blank and everything still works except the demo button, which disappears:
# students register themselves at /register, which the class list gates.
# Supabase → Project Settings → API → "service_role".
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL. Set to "off" to hide the public "Explore the demo" button on a
# deployment that has the service-role key but shouldn't offer a demo (e.g. the
# real classroom instance). Anything else — including unset — leaves it on.
DEMO_MODE=
